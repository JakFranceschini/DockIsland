<Window x:Class="DockIsland.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DockIsland"
        Title="Aplicativos" Width="1040" Height="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Botões em forma de pílula -->
        <Style x:Key="PillBtn" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource W_24}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource W_3D}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Campo de texto dos popups: realça em azul quando está em foco -->
        <Style x:Key="FieldBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource W_1F}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource W_14}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource W_66}"/>
                    <Setter Property="Background" Value="{DynamicResource W_26}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botões dos popups (mesmo formato do popup de desligar) -->
        <Style x:Key="DlgPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource W_33}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource W_4D}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DlgPillAccent" TargetType="Border" BasedOn="{StaticResource DlgPill}">
            <Setter Property="Background" Value="{DynamicResource W_F2}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource W_FF}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cada app na grade -->
        <Style x:Key="AppTile" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource W_26}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <ItemsPanelTemplate x:Key="GridPanel">
            <local:FillWrapPanel MinCellWidth="116"/>
        </ItemsPanelTemplate>

        <DataTemplate x:Key="AppTemplate">
            <Border Style="{StaticResource AppTile}" Margin="2" Padding="4,10"
                    AllowDrop="True" Tag="tile"
                    PreviewMouseLeftButtonDown="App_PreviewDown" PreviewMouseLeftButtonUp="App_PreviewUp"
                    MouseMove="App_Move"
                    MouseLeftButtonUp="App_Click" MouseRightButtonUp="App_RightClick">
                <StackPanel>
                    <Grid Width="56" Height="56" HorizontalAlignment="Center">
                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Border CornerRadius="28" Background="#3A3A3C" Visibility="{Binding FallbackVis}">
                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="22"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Border Visibility="{Binding NotifVis}" MinWidth="17" Height="17" CornerRadius="8.5" Padding="4,0"
                            Background="#FF453A" BorderBrush="#CC000000" BorderThickness="1.5"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-7,0"
                            IsHitTestVisible="False">
                        <TextBlock Text="{Binding NotifText}" Foreground="White" FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                    </Border>
                    </Grid>
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource FgBrush}" FontSize="12.5" Margin="0,8,0,0"
                               TextAlignment="Center" TextWrapping="Wrap" MaxHeight="36"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Card" Margin="30" Background="#80000000" local:Glass.Blur="True" BorderBrush="{DynamicResource W_2E}" BorderThickness="1" CornerRadius="34" Padding="26"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Busca + nova categoria -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource W_24}" CornerRadius="15">
                    <Grid>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{DynamicResource W_80}" Margin="16,0,0,0" VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                        <TextBlock x:Name="SearchHint" Text="Buscar aplicativos" Foreground="{DynamicResource W_66}" FontSize="15"
                                   Margin="46,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource FgBrush}"
                                 CaretBrush="{DynamicResource FgBrush}" FontSize="15" Margin="46,0,12,0" VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PillBtn}" Margin="12,0,0,0" Padding="18,0"
                        MouseLeftButtonUp="AddApp_Click" ToolTip="Adicionar um programa (.exe) ou atalho ao lançador">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Adicionar app" Foreground="{DynamicResource FgBrush}" FontSize="13.5" FontWeight="SemiBold"
                                   Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource PillBtn}" Margin="10,0,0,0" Padding="18,0"
                        MouseLeftButtonUp="AddFolder_Click" ToolTip="Adicionar uma pasta ao lançador">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Adicionar pasta" Foreground="{DynamicResource FgBrush}" FontSize="13.5" FontWeight="SemiBold"
                                   Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource PillBtn}" Margin="10,0,0,0" Padding="18,0"
                        MouseLeftButtonUp="NewCategory_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Nova categoria" Foreground="{DynamicResource FgBrush}" FontSize="13.5" FontWeight="SemiBold"
                                   Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Blocos de categorias (montados no código) -->
            <ScrollViewer x:Name="BlocksScroll" Grid.Row="2" VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False"
                          PreviewDragOver="Blocks_PreviewDragOver">
                <StackPanel x:Name="BlocksPanel"/>
            </ScrollViewer>

            <TextBlock x:Name="LoadingText" Grid.Row="2" Text="Carregando aplicativos…" Foreground="{DynamicResource W_80}"
                       FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <TextBlock x:Name="EmptyText" Grid.Row="2" Foreground="{DynamicResource W_80}" FontSize="13.5"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Text="Nenhum aplicativo encontrado" Visibility="Collapsed"/>

            <!-- Pedido do nome da categoria (nova / renomear): véu escuro + cartão de vidro, no estilo da ilha -->
            <Border x:Name="NameOverlay" Grid.RowSpan="3" Margin="-26" Background="#8C000000" CornerRadius="33"
                    Visibility="Collapsed">
                <Border Width="380" Background="#99000000" local:Glass.Blur="True" CornerRadius="28" Padding="26,26,26,22"
                        BorderBrush="{DynamicResource W_2E}" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource W_1F}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8B7;" Foreground="{DynamicResource W_E6}" FontSize="22"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="NameTitle" Text="Nova categoria" Foreground="{DynamicResource FgBrush}" FontSize="19"
                                   FontWeight="SemiBold" TextAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock Text="Digite o nome (ex.: Jogos, Pastas, Trabalho, Apps)" Foreground="{DynamicResource W_A0}"
                                   FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <Border Style="{StaticResource FieldBox}" Height="44" Margin="0,18,0,0">
                            <TextBox x:Name="NameBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource FgBrush}"
                                     CaretBrush="{DynamicResource FgBrush}" FontSize="14.5" Margin="14,0" MaxLength="30"
                                     VerticalContentAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="NameError" Foreground="#FF6B6B" FontSize="12.5" Margin="2,8,0,0"
                                   TextAlignment="Center" Visibility="Collapsed"/>
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource DlgPill}" MouseLeftButtonUp="NameCancel_Click">
                                <TextBlock Text="Cancelar" Foreground="{DynamicResource FgBrush}" FontSize="14" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource DlgPillAccent}" MouseLeftButtonUp="NameOk_Click">
                                <TextBlock Text="Salvar" Foreground="{DynamicResource InvFgBrush}" FontSize="14" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
