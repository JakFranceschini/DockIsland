<Window x:Class="DockIsland.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DockIsland"
        Title="Dock" Width="1100" Height="100"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        ShowActivated="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <!-- Item do dock (fixado ou aberto): ícone, brilho suave ao passar o mouse e pontinho quando está aberto -->
        <DataTemplate x:Key="DockItem">
            <Grid>
            <Border x:Name="Hit" Width="50" Height="50" Background="Transparent" Cursor="Hand"
                    Visibility="{Binding AppVis}"
                    MouseEnter="Item_Enter" MouseLeave="Item_Leave"
                    PreviewMouseLeftButtonDown="Item_PreviewDown" PreviewMouseLeftButtonUp="Item_PreviewUp" MouseMove="Item_Move"
                    MouseLeftButtonUp="Pinned_Click" MouseRightButtonUp="Pinned_RightClick">
                <Grid>
                    <!-- Realce igual ao do lançador de apps: quadrado arredondado translúcido, sem zoom -->
                    <Border x:Name="Glow" Width="50" Height="50" CornerRadius="16" Opacity="0"
                            BorderBrush="{DynamicResource W_55}" BorderThickness="1" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#52FFFFFF" Offset="0"/>
                                <GradientStop Color="#26FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- Sombra rápida ao clicar (feedback de pressionado) -->
                    <Border x:Name="Press" Width="50" Height="50" CornerRadius="16" Background="#2E000000" Opacity="0"
                            IsHitTestVisible="False"/>
                    <Grid x:Name="IconBox" Width="44" Height="44" HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Border CornerRadius="20" Background="#3A3A3C" Visibility="{Binding FallbackVis}">
                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="16"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <!-- Notificações pendentes do app: selo vermelho no canto superior direito -->
                    <Border Visibility="{Binding NotifVis}" MinWidth="17" Height="17" CornerRadius="8.5" Padding="4,0"
                            Background="#FF453A" BorderBrush="#CC000000" BorderThickness="1.5"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0"
                            IsHitTestVisible="False">
                        <TextBlock Text="{Binding NotifText}" Foreground="White" FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                    </Border>
                    <!-- Mais de uma janela aberta deste app: contador no canto -->
                    <Border Visibility="{Binding MultiVis}" MinWidth="15" Height="15" CornerRadius="7.5" Padding="4,0"
                            Background="#3A3A3C" BorderBrush="{DynamicResource W_80}" BorderThickness="1"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,2"
                            IsHitTestVisible="False">
                        <TextBlock Text="{Binding WindowCount}" Foreground="White" FontSize="9.5" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
                <!-- Divisor (clique direito para remover) -->
                <Border Width="16" Height="50" Background="Transparent" Cursor="Hand" Visibility="{Binding DividerVis}"
                        ToolTip="Divisor (arraste para mover; clique direito para remover)"
                        PreviewMouseLeftButtonDown="Item_PreviewDown" PreviewMouseLeftButtonUp="Item_PreviewUp" MouseMove="Item_Move"
                        MouseRightButtonUp="Divider_RightClick">
                    <Border Width="1" Height="34" Background="{DynamicResource W_33}" HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="Hit" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.14">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- Indicador: barrinha mostrada enquanto o dock está oculto -->
        <Border x:Name="Indicator" Width="140" Height="7" CornerRadius="3.5" Background="#66000000" local:Glass.Blur="True"
                BorderBrush="{DynamicResource W_66}" BorderThickness="0.5" Margin="0,0,0,5"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False"/>

        <!-- ============ DOCK (pílula) ============ -->
        <Border x:Name="Pill" Height="66" Margin="0,0,0,5" CornerRadius="26" Background="#66000000" local:Glass.Blur="True" BorderBrush="{DynamicResource W_2E}" BorderThickness="1" Padding="10,0"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                AllowDrop="True" DragEnter="Pill_DragEnter" DragLeave="Pill_DragLeave" DragOver="Pill_DragOver"
                Drop="Pill_Drop" MouseRightButtonUp="Pill_RightClick">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PillShift" Y="96"/>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Botão do lançador: sempre à esquerda -->
                <Border x:Name="LauncherBtn" Width="76" Height="44" CornerRadius="14" Cursor="Hand"
                        VerticalAlignment="Center" Margin="3,0"
                        ToolTip="Todos os aplicativos (clique direito: personalizar)"
                        MouseLeftButtonUp="Launcher_Click" MouseRightButtonUp="Launcher_RightClick">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource W_24}"/>
                            <Style.Triggers>
                                <Trigger Property="Tag" Value="custom">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource W_33}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <!-- Ícone de menu (quatro quadradinhos arredondados) + texto "Apps" -->
                        <StackPanel x:Name="LauncherGlyph" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="13" Height="13" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <Border Width="5.5" Height="5.5" CornerRadius="0.9" Background="{DynamicResource FgBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Border Width="5.5" Height="5.5" CornerRadius="0.9" Background="{DynamicResource FgBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                <Border Width="5.5" Height="5.5" CornerRadius="0.9" Background="{DynamicResource FgBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <Border Width="5.5" Height="5.5" CornerRadius="0.9" Background="{DynamicResource FgBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>
                            <TextBlock Text="Apps" Margin="7,0,0,0"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Image x:Name="LauncherImg" Width="44" Height="44" Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>
                <Border x:Name="Sep" Width="16" Height="50" Background="Transparent" Cursor="Hand"
                        ToolTip="Divisor (clique direito para remover)" MouseRightButtonUp="Sep_RightClick">
                    <Border Width="1" Height="34" Background="{DynamicResource W_33}" HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                </Border>

                <!-- Fixados -->
                <ItemsControl x:Name="PinnedList" ItemTemplate="{StaticResource DockItem}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Programas abertos que não estão fixados -->
                <Border x:Name="RunSep" Width="16" Height="50" Background="Transparent" Cursor="Hand"
                        ToolTip="Divisor (clique direito para remover)" Visibility="Collapsed"
                        MouseRightButtonUp="RunSep_RightClick">
                    <Border Width="1" Height="34" Background="{DynamicResource W_33}" HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                </Border>
                <ItemsControl x:Name="RunningList" ItemTemplate="{StaticResource DockItem}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

            </StackPanel>
        </Border>

        <!-- Pílula com o nome do app, centralizada acima do ícone (posicionada pelo código) -->
        <Canvas x:Name="TagLayer" IsHitTestVisible="False">
            <!-- Linha que mostra onde o app vai entrar ao soltar (posicionada pelo código) -->
            <Border x:Name="DropLine" Width="3" Height="30" CornerRadius="1.5" Background="{DynamicResource FgBrush}"
                    Visibility="Collapsed"/>
            <!-- Caixa de largura fixa centrada no ícone; a pílula fica centralizada dentro dela,
                 então o centro não depende da largura do texto -->
            <Grid x:Name="NameTagBox" Width="320" Height="34" Visibility="Collapsed">
                <Border x:Name="NameTag" Opacity="0" Background="#66000000" local:Glass.Blur="True" CornerRadius="13"
                        Padding="12,4" BorderBrush="{DynamicResource W_33}" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="TagShift" Y="4"/>
                    </Border.RenderTransform>
                    <TextBlock x:Name="NameTagText" Foreground="{DynamicResource FgBrush}" FontSize="12" FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" MaxWidth="270" TextAlignment="Center"/>
                </Border>
            </Grid>
        </Canvas>
    </Grid>
</Window>
