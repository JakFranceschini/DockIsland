<Window x:Class="DockIsland.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DockIsland"
        Title="Dock" Width="1100" Height="100"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        ShowActivated="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <!-- Item do dock (fixado ou aberto): ícone, brilho suave ao passar o mouse e pontinho quando está aberto -->
        <DataTemplate x:Key="DockItem">
            <Grid>
            <Border x:Name="Hit" Width="50" Height="50" Background="Transparent" Cursor="Hand"
                    Visibility="{Binding AppVis}"
                    MouseEnter="Item_Enter" MouseLeave="Item_Leave"
                    PreviewMouseLeftButtonDown="Item_PreviewDown" PreviewMouseLeftButtonUp="Item_PreviewUp" MouseMove="Item_Move"
                    MouseLeftButtonUp="Pinned_Click" MouseRightButtonUp="Pinned_RightClick">
                <Border.Triggers>
                    <!-- Efeito de clique: o ícone afunda ao pressionar e volta com um quique ao soltar -->
                    <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="IconBox" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                 To="0.9" Duration="0:0:0.14">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="IconBox" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                 To="0.9" Duration="0:0:0.14">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="IconBox" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                 To="1" Duration="0:0:0.45">
                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.9"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="IconBox" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                 To="1" Duration="0:0:0.45">
                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.9"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="IconBox" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                 To="1" Duration="0:0:0.25"/>
                                <DoubleAnimation Storyboard.TargetName="IconBox" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                 To="1" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <!-- Realce igual ao do lançador de apps: quadrado arredondado translúcido, sem zoom -->
                    <Border x:Name="Glow" Width="50" Height="50" CornerRadius="16" Opacity="0"
                            BorderBrush="{DynamicResource W_55}" BorderThickness="1" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#52FFFFFF" Offset="0"/>
                                <GradientStop Color="#26FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- Sombra rápida ao clicar (feedback de pressionado) -->
                    <Border x:Name="Press" Width="50" Height="50" CornerRadius="16" Background="#2E000000" Opacity="0"
                            IsHitTestVisible="False"/>
                    <Grid x:Name="IconBox" Width="44" Height="44" HorizontalAlignment="Center"
                          VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Border CornerRadius="12" Background="#3A3A3C" Visibility="{Binding FallbackVis}">
                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="16"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <!-- Notificações pendentes do app: selo vermelho no canto superior direito -->
                    <Border Visibility="{Binding NotifVis}" MinWidth="17" Height="17" CornerRadius="8.5" Padding="4,0"
                            Background="#FF453A" BorderBrush="#CC000000" BorderThickness="1.5"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0"
                            IsHitTestVisible="False">
                        <TextBlock Text="{Binding NotifText}" Foreground="White" FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                    </Border>
                    <!-- Mais de uma janela aberta deste app: contador no canto -->
                    <Border Visibility="{Binding MultiVis}" MinWidth="15" Height="15" CornerRadius="7.5" Padding="4,0"
                            Background="#3A3A3C" BorderBrush="{DynamicResource W_80}" BorderThickness="1"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,2"
                            IsHitTestVisible="False">
                        <TextBlock Text="{Binding WindowCount}" Foreground="White" FontSize="9.5" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
                <!-- Divisor (clique direito para remover) -->
                <Border Width="16" Height="50" Background="Transparent" Cursor="Hand" Visibility="{Binding DividerVis}"
                        ToolTip="Divisor (arraste para mover; clique direito para remover)"
                        PreviewMouseLeftButtonDown="Item_PreviewDown" PreviewMouseLeftButtonUp="Item_PreviewUp" MouseMove="Item_Move"
                        MouseRightButtonUp="Divider_RightClick">
                    <Border Width="1" Height="34" Background="{DynamicResource W_33}" HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="Hit" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.14">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- Indicador: barrinha mostrada enquanto o dock está oculto -->
        <Border x:Name="Indicator" Width="140" Height="7" CornerRadius="3.5" Background="#66000000" local:Glass.Blur="True"
                BorderBrush="{DynamicResource W_66}" BorderThickness="0.5" Margin="0,0,0,2"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False"/>

        <!-- ============ DOCK (pílula) ============ -->
        <!-- Dois docks lado a lado: apps (Pill) e widgets (WidgetsPill). A linha toda sobe/desce junto (PillShift). -->
        <StackPanel x:Name="DockRow" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="PillShift" Y="96"/>
            </StackPanel.RenderTransform>
        <Border x:Name="Pill" Height="66" VerticalAlignment="Bottom" CornerRadius="24" Background="#66000000" local:Glass.Blur="True" BorderBrush="{DynamicResource W_2E}" BorderThickness="1" Padding="7,0"
                AllowDrop="True" DragEnter="Pill_DragEnter" DragLeave="Pill_DragLeave" DragOver="Pill_DragOver"
                Drop="Pill_Drop" MouseRightButtonUp="Pill_RightClick">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Botão do lançador: sempre à esquerda -->
                <Border x:Name="LauncherBtn" Width="76" Height="44" CornerRadius="14" Cursor="Hand"
                        VerticalAlignment="Center" Margin="0"
                        ToolTip="Todos os aplicativos (clique direito: personalizar)"
                        MouseLeftButtonUp="Launcher_Click" MouseRightButtonUp="Launcher_RightClick">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource W_24}"/>
                            <Style.Triggers>
                                <Trigger Property="Tag" Value="custom">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource W_33}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Triggers>
                        <!-- Efeito de clique: o conteúdo afunda ao pressionar e volta com um quique ao soltar -->
                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                            <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="LauncherInner" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.84" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LauncherInner" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.84" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            </Storyboard></BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                            <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="LauncherInner" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.45"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="1.4"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LauncherInner" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.45"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="1.4"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            </Storyboard></BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="LauncherInner" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.25"></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LauncherInner" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.25"></DoubleAnimation>
                            </Storyboard></BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <Grid x:Name="LauncherInner" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                        <!-- Ícone de menu (quatro quadradinhos arredondados) + texto "Apps" -->
                        <StackPanel x:Name="LauncherGlyph" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="13" Height="13" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <Border Width="5.5" Height="5.5" CornerRadius="0.9" Background="{DynamicResource FgBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Border Width="5.5" Height="5.5" CornerRadius="0.9" Background="{DynamicResource FgBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                <Border Width="5.5" Height="5.5" CornerRadius="0.9" Background="{DynamicResource FgBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <Border Width="5.5" Height="5.5" CornerRadius="0.9" Background="{DynamicResource FgBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>
                            <TextBlock Text="Apps" Margin="7,0,0,0"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Image x:Name="LauncherImg" Width="44" Height="44" Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>
                <Border x:Name="Sep" Width="16" Height="50" Background="Transparent" Cursor="Hand"
                        ToolTip="Divisor (clique direito para remover)" MouseRightButtonUp="Sep_RightClick">
                    <Border Width="1" Height="34" Background="{DynamicResource W_33}" HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                </Border>

                <!-- Fixados -->
                <ItemsControl x:Name="PinnedList" ItemTemplate="{StaticResource DockItem}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Programas abertos que não estão fixados -->
                <Border x:Name="RunSep" Width="16" Height="50" Background="Transparent" Cursor="Hand"
                        ToolTip="Divisor (clique direito para remover)" Visibility="Collapsed"
                        MouseRightButtonUp="RunSep_RightClick">
                    <Border Width="1" Height="34" Background="{DynamicResource W_33}" HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                </Border>
                <ItemsControl x:Name="RunningList" ItemTemplate="{StaticResource DockItem}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

            </StackPanel>
        </Border>

        <!-- Dock de widgets (ligados/desligados em Ajustes > Dock > Widgets): só aparece com algum widget visível -->
        <Border x:Name="WidgetsPill" Visibility="Collapsed" Height="66" Margin="8,0,0,0" VerticalAlignment="Bottom" CornerRadius="24"
                Background="#66000000" local:Glass.Blur="True" BorderBrush="{DynamicResource W_2E}" BorderThickness="1" Padding="7,0"
                MouseRightButtonUp="Pill_RightClick" PreviewMouseWheel="WidgetsPill_Wheel">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Widget de música: aparece com o player aberto (Spotify...) -->
                    <Border x:Name="MusicWidget" Visibility="Collapsed" Height="50" Width="228" CornerRadius="16" Background="#33000000"
                            Padding="5,0,5,0" Margin="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource W_26}" VerticalAlignment="Center"
                                    RenderOptions.BitmapScalingMode="HighQuality">
                                <Grid>
                                    <TextBlock Text="&#x266B;" Foreground="{DynamicResource W_80}" FontSize="16" FontFamily="Segoe UI Symbol"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border CornerRadius="11">
                                        <Border.Background>
                                            <ImageBrush x:Name="MusicArtBrush" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="9,0,4,0" Width="75">
                                <!-- Título e artista: se não couberem, rolam para o lado (letreiro) para mostrar o nome todo -->
                                <!-- O TextBlock visível fica num Canvas: o WPF corta (layout clip) qualquer elemento maior que o espaço
                                     que recebeu, e esse corte acompanhava o texto ao rolar. O Canvas não limita o tamanho do filho.
                                     O TextBlock invisível (Sizer) só dá à área a largura/altura certas. -->
                                <Grid x:Name="MusicTitleHost" ClipToBounds="True">
                                    <TextBlock x:Name="MusicTitleSizer" Visibility="Hidden" FontSize="13.5" FontWeight="SemiBold"
                                               Text="{Binding Text, ElementName=MusicTitle}" TextTrimming="CharacterEllipsis"/>
                                    <Canvas>
                                        <TextBlock x:Name="MusicTitle" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"
                                                   TextWrapping="NoWrap">
                                            <TextBlock.RenderTransform><TranslateTransform x:Name="MusicTitleShift"/></TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Canvas>
                                </Grid>
                                <Grid x:Name="MusicArtistHost" ClipToBounds="True" Margin="0,1,0,0">
                                    <TextBlock x:Name="MusicArtistSizer" Visibility="Hidden" FontSize="11.5"
                                               Text="{Binding Text, ElementName=MusicArtist}" TextTrimming="CharacterEllipsis"/>
                                    <Canvas>
                                        <TextBlock x:Name="MusicArtist" FontSize="11.5" Foreground="{DynamicResource W_A0}" TextWrapping="NoWrap">
                                            <TextBlock.RenderTransform><TranslateTransform x:Name="MusicArtistShift"/></TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Canvas>
                                </Grid>
                            </StackPanel>
                            <Border Width="30" Height="30" CornerRadius="10" Cursor="Hand" VerticalAlignment="Center"
                                    ToolTip="Anterior" MouseLeftButtonUp="MusicPrev_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource W_26}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Path Fill="{DynamicResource FgBrush}" Stretch="Uniform" Width="15" Height="12"
                                      Data="M22,5 L13,12 L22,19 Z M12,5 L3,12 L12,19 Z"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Width="30" Height="30" CornerRadius="10" Cursor="Hand" VerticalAlignment="Center"
                                    ToolTip="Pausar / tocar" MouseLeftButtonUp="MusicPlay_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource W_26}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Path x:Name="MusicPlayIcon" Fill="{DynamicResource FgBrush}" Stretch="Uniform" Width="13" Height="13"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Width="30" Height="30" CornerRadius="10" Cursor="Hand" VerticalAlignment="Center"
                                    ToolTip="Próxima" MouseLeftButtonUp="MusicNext_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource W_26}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Path Fill="{DynamicResource FgBrush}" Stretch="Uniform" Width="15" Height="12"
                                      Data="M2,5 L11,12 L2,19 Z M12,5 L21,12 L12,19 Z"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- Widget de previsão do tempo: cartão com degradê, do mesmo tamanho do widget de música (altura 50, cantos 16).
                         Cores e ilustração mudam com o tempo (desenhado por DockWindow.Weather.cs) -->
                    <Border x:Name="WeatherWidget" Visibility="Collapsed" Height="50" Width="228" CornerRadius="16" VerticalAlignment="Center"
                            Background="#5B8EF5" Cursor="Hand" ToolTip="Clique para abrir a previsão no MSN" MouseLeftButtonUp="Weather_Click">
                        <Grid x:Name="WeatherRoot">
                            <!-- a ilustração é desenhada para 120 x 64 e reduzida para caber nos 50 de altura -->
                            <Canvas x:Name="WeatherArt" Width="120" Height="64" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    IsHitTestVisible="False" RenderTransformOrigin="1,0">
                                <Canvas.RenderTransform><ScaleTransform ScaleX="0.78" ScaleY="0.78"/></Canvas.RenderTransform>
                            </Canvas>
                            <Grid Margin="14,0,0,0" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="WeatherCond" MaxWidth="110" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="#F2FFFFFF" Margin="2,0,0,-3"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="WeatherTemp" FontSize="26" FontWeight="Light" Foreground="White"
                                                   FontFamily="Segoe UI Variable Display Light, Segoe UI Light, Segoe UI"/>
                                        <!-- grau: anel pequeno no alto, como na referência -->
                                        <Ellipse Width="5" Height="5" Stroke="White" StrokeThickness="1.1" VerticalAlignment="Top" Margin="2,8,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Rectangle Grid.Column="1" Width="1" Height="26" Fill="#66FFFFFF" VerticalAlignment="Bottom" Margin="10,0,10,8"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                    <TextBlock x:Name="WeatherDate" FontSize="10.5" Foreground="#F2FFFFFF"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                        <TextBlock Text="&#xE707;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="White"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="WeatherPlace" FontSize="10.5" Foreground="White" MaxWidth="74" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <!-- Widget de relógio + calendário: quadradinho do dia (mês em cima) e hora grande com o dia da semana -->
                    <Border x:Name="ClockWidget" Visibility="Collapsed" Height="50" Width="228" CornerRadius="16" Background="#33000000"
                            Padding="5,0,16,0" VerticalAlignment="Center">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- data à esquerda -->
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="11" Background="{DynamicResource W_26}" VerticalAlignment="Center">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="ClockMonth" FontSize="9.5" FontWeight="Bold" Foreground="#FF453A" HorizontalAlignment="Center"
                                               Margin="0,0,0,-2"/>
                                    <TextBlock x:Name="ClockDay" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <!-- hora à direita (a coluna do meio é o espaço entre os dois) -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock x:Name="ClockTime" FontSize="22" FontWeight="Light" Foreground="{DynamicResource FgBrush}"
                                           FontFamily="Segoe UI Variable Display Light, Segoe UI Light, Segoe UI" Margin="0,-3,0,-3"
                                           HorizontalAlignment="Right"/>
                                <TextBlock x:Name="ClockWeekday" FontSize="11.5" Foreground="{DynamicResource W_A0}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- Widget do último item copiado: texto ou miniatura da captura de tela; clicar copia de novo -->
                    <Border x:Name="ClipWidget" Visibility="Collapsed" Height="50" Width="228" CornerRadius="16" Background="#33000000"
                            Padding="5,0,5,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Clique para copiar de novo"
                            MouseLeftButtonUp="Clip_Click">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="11" Background="{DynamicResource W_26}" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock x:Name="ClipGlyph" Text="&#xE77F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17"
                                               Foreground="{DynamicResource W_80}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border CornerRadius="11">
                                        <Border.Background>
                                            <ImageBrush x:Name="ClipThumbBrush" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,6,0">
                                <TextBlock x:Name="ClipLabel" Text="Último copiado" FontSize="10.5" Foreground="{DynamicResource W_A0}"/>
                                <!-- Texto que não cabe rola para o lado (letreiro), igual ao título do widget de música -->
                                <Grid x:Name="ClipTextHost" ClipToBounds="True">
                                    <TextBlock x:Name="ClipTextSizer" Visibility="Hidden" FontSize="13" FontWeight="SemiBold"
                                               Text="{Binding Text, ElementName=ClipText}" TextTrimming="CharacterEllipsis"/>
                                    <Canvas>
                                        <TextBlock x:Name="ClipText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"
                                                   TextWrapping="NoWrap">
                                            <TextBlock.RenderTransform><TranslateTransform x:Name="ClipTextShift"/></TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Canvas>
                                </Grid>
                            </StackPanel>
                            <Border Grid.Column="2" Width="30" Height="30" CornerRadius="10" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource W_26}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{DynamicResource FgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Widget da lixeira: quantidade e tamanho; o botão pede confirmação (2 cliques) antes de esvaziar -->
                    <Border x:Name="TrashWidget" Visibility="Collapsed" Height="50" Width="228" CornerRadius="16" Background="#33000000"
                            Padding="5,0,5,0" VerticalAlignment="Center">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="11" Background="{DynamicResource W_26}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17"
                                           Foreground="{DynamicResource FgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,6,0">
                                <TextBlock Text="Lixeira" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"/>
                                <TextBlock x:Name="TrashSub" FontSize="11.5" Foreground="{DynamicResource W_A0}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Border x:Name="TrashActBtn" Grid.Column="2" Height="28" MinWidth="30" CornerRadius="10" Cursor="Hand" VerticalAlignment="Center"
                                    Padding="10,0" ToolTip="Esvaziar a lixeira" MouseLeftButtonUp="TrashAct_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource W_26}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource W_33}"/>
                                            </Trigger>
                                            <Trigger Property="Tag" Value="confirm">
                                                <Setter Property="Background" Value="#FF453A"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock x:Name="TrashActText" Text="Esvaziar" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource FgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
            </StackPanel>
        </Border>
        </StackPanel>

        <!-- Pílula com o nome do app, centralizada acima do ícone (posicionada pelo código) -->
        <Canvas x:Name="TagLayer" IsHitTestVisible="False">
            <!-- Linha que mostra onde o app vai entrar ao soltar (posicionada pelo código) -->
            <Border x:Name="DropLine" Width="3" Height="30" CornerRadius="1.5" Background="{DynamicResource FgBrush}"
                    Visibility="Collapsed"/>
            <!-- Caixa de largura fixa centrada no ícone; a pílula fica centralizada dentro dela,
                 então o centro não depende da largura do texto -->
            <Grid x:Name="NameTagBox" Width="320" Height="34" Visibility="Collapsed">
                <Border x:Name="NameTag" Opacity="0" Background="#66000000" local:Glass.Blur="True" CornerRadius="13"
                        Padding="12,4" BorderBrush="{DynamicResource W_33}" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="TagShift" Y="4"/>
                    </Border.RenderTransform>
                    <TextBlock x:Name="NameTagText" Foreground="{DynamicResource FgBrush}" FontSize="12" FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" MaxWidth="270" TextAlignment="Center"/>
                </Border>
            </Grid>
        </Canvas>
    </Grid>
</Window>
